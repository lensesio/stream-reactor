{
  "connector.class": "io.lenses.streamreactor.connect.datalake.sink.DatalakeSinkConnector",
  "tasks.max": "3",
  "topics": "adls-dev-topic",

  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",

  "connect.datalake.kcql": "INSERT INTO REPLACE_ME_FILESYSTEM:adls-dev SELECT * FROM adls-dev-topic STOREAS `JSON` WITH_FLUSH_COUNT = 1",

  "connect.datalake.azure.auth.mode": "connectionstring",
  "connect.datalake.azure.connection.string": "REPLACE_ME_CONNECTION_STRING",

  "connect.datalake.local.tmp.directory": "/tmp/adls-staging"
}
